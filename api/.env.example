# Copy this file to api/.env and fill in your WooCommerce credentials.
WC_URL=https://your-woocommerce-site.com/wp-json/wc/v3
WC_KEY=ck_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WC_SECRET=cs_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Optional: allow only the Vite dev server origin to call this API.
ALLOWED_ORIGIN=http://localhost:5173
# Optional: set to true if your WooCommerce server uses a self-signed certificate in development.
WC_SKIP_TLS_VERIFY=true
# Optional: custom backend port
PORT=3000
